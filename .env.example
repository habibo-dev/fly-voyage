# Fly Voyages Algérie — environment variables
#
# Copy this file to .env.local for local overrides.
# NO real secrets are required to run this project.
# The site is fully functional without any API keys.

# Public site origin, used for Open Graph URLs, sitemap and robots.
# Set your real domain before going live, e.g. https://www.flyvoyages.dz
NEXT_PUBLIC_SITE_URL=https://flyvoyages.example.com
